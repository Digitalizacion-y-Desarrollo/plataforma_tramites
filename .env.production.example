APP_NAME="Portal de Trámites"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.example.gob.mx

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=portal_tramites
DB_USERNAME=portal_tramites
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

ACCESOS_LOGIN_URL=https://accesos.digitalneza.com/api/auth/login
ACCESOS_PROFILE_URL=https://accesos.digitalneza.com/api/auth/me
ACCESOS_LOGOUT_URL=https://accesos.digitalneza.com/api/auth/logout
ACCESOS_DEPARTAMENTOS_URL=https://accesos.digitalneza.com/api/departamentos
ACCESOS_TIMEOUT=15
ACCESOS_CA_BUNDLE=
ACCESOS_SYSTEM_KEY=
